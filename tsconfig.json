{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2020",
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "baseUrl": ".",
    "types": ["react"]
  },
  "include": ["src"]
}
